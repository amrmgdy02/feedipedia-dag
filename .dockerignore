# Keep the build context small — the image needs only requirements.txt and the
# Python sources under dags/. Nothing is read from disk at runtime.
#
# NOTE: patterns are matched against the path relative to the context root and do
# NOT recurse on their own, so anything that can appear in a subdirectory needs the
# explicit **/ prefix.

# Virtualenv (local dev only)
.venv/
venv/

# Git metadata
.git/
.gitignore

# Scratch / one-off files
a.py

# Python build artifacts
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

# Docs & local data
README.md
data/
config/

# Source-research artifacts that live beside the code but are not runtime inputs:
# the BigQuery export used for cross-checking, its Excel lock file, the scratch
# notebook, and the CSV the REGION_COUNTRIES dict in utils.py was built from.
**/*.xlsx
**/~$*
**/*.ipynb
**/*.csv
