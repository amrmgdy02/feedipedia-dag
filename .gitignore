# ============================================================
# Feedipedia ETL — Git ignore rules
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / environment files ---
.env
.env.*
!.env.example

# --- Airflow runtime ---
logs/
airflow.cfg
config/airflow.cfg
airflow.db
airflow-webserver.pid
unittests.cfg
*.pid

# --- Generated ETL data ---
# SQLite database produced by the load step
data/feedipedia.db
# API raw pages (timestamped per run) and transformed staging NDJSON
data/raw/
data/staging/

# --- Large / one-off data exports (not source code) ---
Feedipedia_BigQuery_Full_Export*.xlsx
*.xlsx.tmp
# Office lock files (~$Book.xlsx) — the pattern above misses them because the
# filename starts with the ~$ prefix.
~$*
# Source for the REGION_COUNTRIES dict in utils.py; not read at runtime.
dags/feedipedia_etl/region_countries_master.csv

# --- Scratch, not part of this project ---
# DIEM/ArcGIS DAG that happens to sit in this working directory.
a.py

# --- Editors / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log